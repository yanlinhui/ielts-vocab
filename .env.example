# 复制成 .env 再填值。这个文件只放变量名，不放真实值。

# 运行时连接串。本地是 postgresql://postgres:ielts_dev@localhost:5432/ielts?schema=public
# 线上用 Neon 的 pooled 串（主机名带 -pooler）
DATABASE_URL=""

# 迁移和 seed 走直连。本地与 DATABASE_URL 相同；线上不带 -pooler
DIRECT_URL=""

# npm run auth:hash -- "你的密码" 的输出。分隔符是冒号，不是美元符
AUTH_PASSWORD_HASH=""

# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
