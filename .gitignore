node_modules/
.pnp
.pnp.js

# ---- 构建产物 ----
.next/
out/
build/
dist/
next-env.d.ts

# ---- 环境变量 ----
.env
.env*.local

# ---- 词表与提取流水线的全部产物：含书中原文，绝不入库 ----
# data/ 里是例句、搭配、词根词源——出版社的版权内容。整个目录由
# scripts/ 从自备原书生成，只在本地使用，不进公开仓库。
data/
ecdict/

# ---- 原始资料：书本身，绝不入库 ----
*.pdf
*.docx

# ---- Python ----
.venv/
__pycache__/
*.py[cod]

# ---- 数据库 ----
prisma/*.db*
prisma/migrations/**/*.db

# ---- 杂项 ----
.DS_Store
Thumbs.db
*.log
*.tsbuildinfo
.idea/
.vscode/*
!.vscode/extensions.json

# ---- 本机设置 ----
.claude/settings.local.json
